[Unit]
Description=Evalstone API Celery worker
After=network.target redis-server.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/evalstone-api/current
EnvironmentFile=/home/ubuntu/evalstone-api/current/.env
Environment=PATH=/home/ubuntu/evalstone-api/current/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/ubuntu/evalstone-api/current/venv/bin/celery -A app.worker.celery_app worker --loglevel=INFO --pool=prefork --concurrency=1 --hostname=evalstone-api-worker@%h
StandardOutput=append:/home/ubuntu/evalstone-api/current/logs/celery.log
StandardError=append:/home/ubuntu/evalstone-api/current/logs/celery.error.log
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
