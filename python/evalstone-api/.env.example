APP_NAME=evalstone-api
APP_ENV=development
APP_PORT=8181

# native PostgreSQL 16 (docs/LOCAL_SERVICES.md): DB_USER is the OS user, blank DB_PASS = trust auth
# DB_USER defaults to your OS user (Homebrew Postgres); set it only if yours differs
# DB_USER=
DB_PASS=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=evalstone_api_development
DB_TEST_NAME=evalstone_api_test

# Redis index 7 — pick an unused one per machine; shared by Celery broker + result backend
REDIS_URL=redis://localhost:6379/7
CELERY_BROKER_URL=redis://localhost:6379/7
CELERY_RESULT_BACKEND=redis://localhost:6379/7
CELERY_TASK_ALWAYS_EAGER=false
CELERY_POOL=solo
CELERY_CONCURRENCY=1

# /docs + /openapi.json are behind HTTP basic auth
DOCS_USERNAME=evalstone
DOCS_PASSWORD=change-me

CORS_ORIGINS=http://localhost:3000,http://localhost:8182

# auth — the API refuses to start outside development/test with these dev values
JWT_SECRET=dev-only-change-me-dev-only-change-me
JWT_EXPIRES_MINUTES=10080
