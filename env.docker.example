# Copy to .env next to docker-compose.yml. FOUR values are REQUIRED — DB_PASS, JWT_SECRET,
# PROVIDER_CREDS_KEY, DOCS_PASSWORD — the API refuses to start with any of them empty or set
# to a published default. Generate them once and never change PROVIDER_CREDS_KEY (it decrypts
# every stored provider key).
#
#   JWT_SECRET:         python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
#   PROVIDER_CREDS_KEY: python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
#                       (or: docker run --rm python:3.13-slim sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'")
#   DB_PASS:            any strong password (it is the Postgres password inside the stack)
#   DOCS_PASSWORD:      what you type at /docs (basic auth, user DOCS_USERNAME)

DB_PASS=
JWT_SECRET=
PROVIDER_CREDS_KEY=
DOCS_USERNAME=evalstone
DOCS_PASSWORD=

# optional
# API_PORT=8181
# CORS_ORIGINS=http://localhost:3000
# PROVIDER_ALLOW_PRIVATE_URLS=false   # true when your model gateway (e.g. Ollama) is on a private host
