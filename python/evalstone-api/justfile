# evalstone-api — the center API. Builder-convention recipe set (docs/API.md §2, docs/LOCAL_SERVICES.md).
set dotenv-load := true

venv := "venv/bin"
python := env_var_or_default("PYTHON", "python3.13")
SITE := "evalstone-api"

default:
    @just --list

# --- setup -------------------------------------------------------------------

# create ./venv (PYTHON=python3.12 to override) and install runtime + dev requirements
install:
    test -d venv || {{python}} -m venv venv
    {{venv}}/pip install -q --upgrade pip
    {{venv}}/pip install -q -r requirements-dev.txt

# verify the native local services this project needs are up
services-check:
    #!/usr/bin/env bash
    set -uo pipefail
    pg_isready -h "${DB_HOST}" -p "${DB_PORT}" || echo "postgres DOWN — brew services start postgresql@16"
    redis-cli -u "${REDIS_URL}" ping >/dev/null 2>&1 && echo "redis: PONG" || echo "redis DOWN — brew services start redis"

# --- database ----------------------------------------------------------------

# create development + test databases (no-op when they exist)
db-create-all:
    #!/usr/bin/env bash
    set -euo pipefail
    for db in "${DB_NAME}" "${DB_TEST_NAME}"; do
      if psql -h "${DB_HOST}" -p "${DB_PORT}" -U "${DB_USER:-$USER}" -d postgres -Atc "select 1 from pg_database where datname='${db}'" | grep -q 1; then
        echo "exists: ${db}"
      else
        createdb -h "${DB_HOST}" -p "${DB_PORT}" -U "${DB_USER:-$USER}" "${db}" && echo "created: ${db}"
      fi
    done

# drop ONLY this project's databases; FORCE=1 terminates open connections first
db-drop-all:
    #!/usr/bin/env bash
    set -euo pipefail
    for db in "${DB_NAME}" "${DB_TEST_NAME}"; do
      case "$db" in evalstone_api_*) ;; *) echo "refusing to drop non-evalstone db: $db"; exit 1;; esac
      if [ "${FORCE:-0}" = "1" ]; then
        psql -h "${DB_HOST}" -p "${DB_PORT}" -U "${DB_USER:-$USER}" -d postgres -c "DROP DATABASE IF EXISTS \"${db}\" WITH (FORCE)"
      else
        dropdb --if-exists -h "${DB_HOST}" -p "${DB_PORT}" -U "${DB_USER:-$USER}" "${db}"
      fi
      echo "dropped: ${db}"
    done

# alembic upgrade head on development + test
db-migrate-all:
    ALEMBIC_DB_NAME="${DB_NAME}" {{venv}}/alembic upgrade head
    ALEMBIC_DB_NAME="${DB_TEST_NAME}" {{venv}}/alembic upgrade head

# new autogenerated migration: just db-revision "add organizations"
db-revision message:
    ALEMBIC_DB_NAME="${DB_NAME}" {{venv}}/alembic revision --autogenerate -m "{{message}}"

# psql shell on the development database
db:
    psql -h "${DB_HOST}" -p "${DB_PORT}" -U "${DB_USER:-$USER}" -d "${DB_NAME}"

# --- run ---------------------------------------------------------------------

# start the API with reload
up:
    {{venv}}/uvicorn app.main:app --host 0.0.0.0 --port "${APP_PORT}" --reload

# celery worker (CELERY_POOL=solo on macOS; prefork on Linux)
workers:
    {{venv}}/celery -A app.worker.celery_app worker --loglevel=info --pool "${CELERY_POOL:-prefork}" --concurrency "${CELERY_CONCURRENCY:-1}"

# celery beat (scheduled tasks: see app/worker.py beat_schedule)
beat:
    {{venv}}/celery -A app.worker.celery_app beat --loglevel=info

# IPython console with `db`, models and tasks preloaded
console:
    {{venv}}/ipython -i scripts/console.py

# --- quality -----------------------------------------------------------------

# run the test suite against the _test database
test *args:
    APP_ENV=test {{venv}}/pytest {{args}}

# ruff check + format --check without changing files
lint:
    {{venv}}/ruff check .
    {{venv}}/ruff format --check .

# tests + linters — run before pushing (same as CI)
check: lint test

# auto-fix lint problems and format the code
formatters-fix:
    {{venv}}/ruff check --fix .
    {{venv}}/ruff format .

# --- deploy (homemarket-web01; docs/features/COMPLETE_SERVER_BASED.md) -------

# git-clone deploy to the server in deploy.json (needs .env.production locally)
deploy env="production":
    ./deploy.sh {{env}}

# install + enable the three systemd units from current/app/support/systemd/
setup-systemd:
    #!/usr/bin/env bash
    set -e
    SERVER=$(python3 -c "import json; print(json.load(open('deploy.json'))['production']['server'])")
    LOC=$(python3 -c "import json; print(json.load(open('deploy.json'))['production']['deploy_location'])")
    for unit in app/support/systemd/*.service; do
      name=$(basename "$unit")
      ssh "$SERVER" "sudo cp $LOC/current/$unit /etc/systemd/system/$name && sudo systemctl daemon-reload && sudo systemctl enable $name"
      echo "installed $name"
    done

# install the HTTP vhost (serves the ACME challenge) into /opt/nginx and reload
setup-nginx-http:
    #!/usr/bin/env bash
    set -e
    SERVER=$(python3 -c "import json; print(json.load(open('deploy.json'))['production']['server'])")
    LOC=$(python3 -c "import json; print(json.load(open('deploy.json'))['production']['deploy_location'])")
    ssh "$SERVER" "set -e; sudo cp $LOC/current/nginx/nginx-http.conf /opt/nginx/conf/sites-available/{{SITE}}.conf && sudo ln -sf /opt/nginx/conf/sites-available/{{SITE}}.conf /opt/nginx/conf/sites-enabled/{{SITE}}.conf && sudo /opt/nginx/sbin/nginx -t && sudo /opt/nginx/sbin/nginx -s reload"
    echo "nginx HTTP vhost installed"

# switch the vhost to HTTPS (certs must exist in shared/certs/) and reload
setup-nginx-https:
    #!/usr/bin/env bash
    set -e
    SERVER=$(python3 -c "import json; print(json.load(open('deploy.json'))['production']['server'])")
    LOC=$(python3 -c "import json; print(json.load(open('deploy.json'))['production']['deploy_location'])")
    ssh "$SERVER" "set -e; test -s $LOC/shared/certs/fullchain.pem; sudo cp $LOC/current/nginx/nginx-https.conf /opt/nginx/conf/sites-available/{{SITE}}.conf && sudo /opt/nginx/sbin/nginx -t && sudo /opt/nginx/sbin/nginx -s reload"
    echo "nginx HTTPS vhost installed"
